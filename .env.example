# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Any random string of your choosing - protects your webhook endpoint
TELEGRAM_WEBHOOK_SECRET=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: signing secret from your OpenRouter workspace settings,
# used to verify that /api/video-callback calls really come from OpenRouter
OPENROUTER_WEBHOOK_SECRET=

# Any OpenRouter video model, see https://openrouter.ai/collections/video-models
VIDEO_MODEL=google/veo-3.1-fast

# The public URL of your deployed Vercel project (no trailing slash)
PUBLIC_BASE_URL=https://your-app.vercel.app

# Auto-filled by Vercel when you attach a KV (Upstash Redis) store to the project
KV_REST_API_URL=
KV_REST_API_TOKEN=
